{
  "name": "kultr-desktop",
  "productName": "Kultr",
  "version": "1.14.0",
  "description": "Kultr for Windows and Linux: a music player for Navidrome, or for the music on your computer.",
  "author": "evropiani",
  "license": "MIT",
  "homepage": "https://github.com/evropiani/Kultr",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist:linux": "npm run prepare-app && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "cc.kultr.desktop",
    "productName": "Kultr",
    "executableName": "kultr",
    "copyright": "Kultr contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "app/**/*",
      "package.json"
    ],
    "artifactName": "Kultr-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kultr",
      "artifactName": "Kultr-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Kultr-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Music player for Navidrome or the music on your computer",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Kultr",
          "Comment": "Music player for Navidrome or the music on your computer",
          "Categories": "AudioVideo;Audio;Player;",
          "StartupWMClass": "Kultr"
        }
      },
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Kultr-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "kultr_${version}_amd64.${ext}",
      "packageCategory": "sound",
      "maintainer": "evropiani <noreply@kultr.cc>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "evropiani",
        "repo": "Kultr",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "kultr.desktop"
}
