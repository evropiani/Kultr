# Copy to .env to change how Kultr is built and served.
# Every one of these is optional.

# ----------------------------------------------------------------- building --

# Public path the app is served from. "/" for a normal host or the built-in
# server; "/Kultr/" for a GitHub Pages project site.
KULTR_BASE=/

# During `npm run dev` only: proxy /rest and /share to this Navidrome, so the
# dev server and the API share an origin and there is no CORS to fight.
KULTR_PROXY_TARGET=http://localhost:4533

# Pre-fill the server field on the login screen.
# VITE_NAVIDROME_URL=https://music.example.com

# Set to 1 to hide the server field entirely (for a single-server deployment).
# VITE_LOCK_SERVER=1

# ------------------------------------------------------------------ serving --

# Used by `npm run serve` and the Docker image.
PORT=4180
HOST=0.0.0.0

# Reverse-proxy /rest and /share to this Navidrome. Setting this is what lets
# you leave the server field blank on the login screen.
KULTR_NAVIDROME_URL=http://localhost:4533

# --------------------------------------------------- docker-compose.full.yml --

# Where your music lives on the host.
MUSIC_DIR=./music
