{
  "name": "kultr",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Kultr \u2014 a modern, minimalist web client for Navidrome with crossfade and InjeKt mixing",
  "license": "Apache-2.0",
  "homepage": "https://github.com/evropiani/Kultr",
  "repository": {
    "type": "git",
    "url": "https://github.com/evropiani/Kultr.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "serve": "node server/serve.js",
    "test": "node tests/run.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.454.0",
